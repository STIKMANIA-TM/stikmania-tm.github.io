{
  "id": "stikmania-pwa",
  "name": "STIKMANIA - Diseño que se pega",
  "short_name": "STIKMANIA",
  "description": "Stickers personalizados, branding profesional y desarrollo web en La Habana, Cuba",
  "start_url": "/index.html",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#000000",
  "theme_color": "#00FF00",
  "orientation": "portrait-primary",
  "lang": "es",
  "dir": "ltr",
  "scope": "/",
  "scope_extensions": [
    { "origin": "https://stikmania-tm.github.io" }
  ],
  "icons": [
    {
      "src": "images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "images/screenshot-home.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Inicio de STIKMANIA"
    },
    {
      "src": "images/screenshot-stickers.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Cotizador de Stickers"
    }
  ],
  "categories": ["business", "design", "shopping", "lifestyle"],
  "shortcuts": [
    {
      "name": "Tienda Stickers",
      "short_name": "Stickers",
      "description": "Ver tienda de stickers personalizados",
      "url": "/stickers.html",
      "icons": [{ "src": "images/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Branding",
      "short_name": "Branding",
      "description": "Servicios de branding digital",
      "url": "/branding.html",
      "icons": [{ "src": "images/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Desarrollo Web",
      "short_name": "Web",
      "description": "Servicios de desarrollo web",
      "url": "/web.html",
      "icons": [{ "src": "images/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "related_applications": [],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+stikmania",
      "url": "/?url=%s"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "prefer_related_applications": false
}